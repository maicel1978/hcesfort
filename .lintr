linters: linters_with_defaults()
encoding: "UTF-8"
exclusions: list(
    "data-raw",
    "inst/report/_tables.R" = list(object_usage_linter = Inf),
    "inst/report/_readiness.R" = list(object_usage_linter = Inf),
    "inst/report/_figures.R" = list(object_usage_linter = Inf),
    "inst/report/_results.R" = list(object_usage_linter = Inf)
  )
